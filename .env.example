# ─────────────────────────────────────────────────────────────
# Aussient — environment settings
# Copy this file to ".env" and fill in your real values:
#     cp .env.example .env
# ".env" is git-ignored, so your secrets never get committed.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# Anything starting with NEXT_PUBLIC_ is visible in the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────


# ── Site ─────────────────────────────────────────────────────
# The public address of the shop. Use http://localhost:3000 locally
# and https://aussient.com.au in production. Used for links in emails
# and for Stripe's success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ── Database (Supabase PostgreSQL, used through Prisma) ─────
# Supabase dashboard → your project → "Connect" button (top bar) → ORMs tab → Prisma.
# Replace [YOUR-PASSWORD] with your database password
# (reset it under Project Settings → Database if you've forgotten it).

# Pooled connection (port 6543) — used by the app while it runs.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma for migrations.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"


# ── Auth.js (login) ──────────────────────────────────────────
# A long random string used to sign login sessions. Generate one by running:
#     npx auth secret
# (or: openssl rand -base64 32). Use a different value in production.
AUTH_SECRET=""


# ── Cloudinary (product & banner images) ─────────────────────
# Cloudinary console → Settings (gear icon) → API Keys.
# The cloud name is also shown at the top of the console dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# ── Stripe (payments in AUD) ─────────────────────────────────
# Stripe dashboard → Developers → API keys → "Secret key".
# Use the sk_test_... key while developing, sk_live_... in production.
STRIPE_SECRET_KEY=""

# Signing secret for Stripe webhooks (confirms payment events really came from Stripe).
# Local: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#        and copy the whsec_... value it prints.
# Production: Stripe dashboard → Developers → Webhooks → your endpoint → "Signing secret".
STRIPE_WEBHOOK_SECRET=""


# ── Resend (order & account emails) ──────────────────────────
# Resend dashboard → API Keys → Create API key.
RESEND_API_KEY=""

# The "from" address on emails. The domain must be verified in Resend → Domains.
# For quick local testing you can use: onboarding@resend.dev
EMAIL_FROM="Aussient <orders@aussient.com.au>"
