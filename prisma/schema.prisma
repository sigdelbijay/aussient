// Aussient — database schema (Prisma 7, PostgreSQL / Supabase).
// Connection URLs live in prisma7.config.ts (CLI) and src/lib/prisma.ts (runtime).
// Money is stored as Decimal(10,2) in AUD. Run `pnpm prisma migrate dev` to apply.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  LIVE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum DiscountType {
  PERCENT // % off
  AMOUNT // fixed $ off
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum DiscountScope {
  ALL // whole store
  CATEGORY // one category (and the ones inside it)
  PRODUCT_TYPE // every product of one type, e.g. T-shirts
  BRAND // one brand
  COLLECTION // the products in one collection
  PRODUCTS // hand-picked products
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum CollectionType {
  MANUAL // hand-picked products
  AUTOMATIC // products matching the rules
}

enum OrderStatus {
  PAID
  SHIPPED
  CANCELLED
  REFUNDED
}

// ── Core commerce ────────────────────────────────────────────

/// People who can sign in: shoppers plus STAFF/ADMIN who run the store.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? // set when the confirm-email link is clicked (or via Google)
  name          String?
  image         String? // profile picture from Google
  passwordHash  String? // null for Google-only accounts
  role          Role      @default(CUSTOMER)

  // Two-factor (authenticator app) — required for STAFF/ADMIN.
  twoFactorSecret   String? // encrypted TOTP secret
  twoFactorEnabled  Boolean @default(false)
  twoFactorLastStep Int? // last accepted 30s time-step, blocks code reuse

  // Bumped on password change/reset so older login sessions stop working.
  sessionVersion Int @default(0)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  authTokens   AuthToken[]
  orders       Order[]
  addresses    Address[]
  wishlist     Wishlist[]
  reviews      Review[]
  activityLogs ActivityLog[]
  cart         Cart?
}

// ── Catalogue ────────────────────────────────────────────────
// Category tree → ProductType → Product → ProductVariant.
// Nothing here is earring-specific: a product type says which options
// shoppers pick (e.g. Size, Colour) and which spec fields a product has.

/// Product groupings shoppers browse, nested up to 3 levels (e.g. Women > Clothing > Dresses).
model Category {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  image             String?
  order             Int          @default(0) // order among categories with the same parent
  parentId          String? // null = top level
  parent            Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]   @relation("CategoryTree")
  products          Product[] // a product can be in several categories
  discounts         Discount[] // category-scoped discounts
  collectionsByRule Collection[] // automatic collections that use this category
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([parentId])
}

/// A kind of product (e.g. "Earrings", "Watch", "T-shirt"): which options shoppers pick and which specs it has.
model ProductType {
  id                String       @id @default(cuid())
  name              String       @unique
  /// Up to 3 options shoppers pick from, in order, e.g. ["Size", "Colour"]. Empty = nothing to pick.
  optionNames       String[]     @default([])
  /// Spec fields, e.g. [{ "label": "Case size", "kind": "number", "unit": "mm", "filterable": true }].
  /// kind: "text" | "number" | "yes-no" | "pick" (pick-from-list, uses "choices"). See src/lib/product-types.ts.
  specFields        Json         @default("[]")
  sizeGuideId       String?
  sizeGuide         SizeGuide?   @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  products          Product[]
  collectionsByRule Collection[]
  discounts         Discount[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

/// A brand products can belong to (e.g. "Casio"), with its logo.
model Brand {
  id                String       @id @default(cuid())
  name              String       @unique
  slug              String       @unique
  logo              String?
  description       String? // shown at the top of /brands/[slug]
  products          Product[]
  collectionsByRule Collection[]
  discounts         Discount[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

/// A size chart shown on product pages, e.g. "T-shirt sizes".
model SizeGuide {
  id           String        @id @default(cuid())
  name         String
  /// { "columns": ["Size", "Chest", "Length"], "rows": [["S", "92", "70"], ...] }
  table        Json
  notes        String? // e.g. "AU sizes, measurements in cm"
  productTypes ProductType[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// A sellable item. Prices and stock live on its variants (always at least one).
model Product {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  description     String?
  productTypeId   String
  productType     ProductType          @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  brandId         String?
  brand           Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// Spec values keyed by the product type's spec labels, e.g. { "Material": "Sterling silver", "Hypoallergenic": true }.
  specs           Json                 @default("{}")
  tags            String[]             @default([]) // free-form words for search and collections, e.g. ["gift", "summer"]
  details         String? // "Details" tab: one fact per line
  care            String? // "Care" tab
  seoTitle        String? // overrides the page title in Google
  seoDescription  String? // overrides the description in Google
  status          ProductStatus        @default(DRAFT)
  featured        Boolean              @default(false)
  // Hand-picked "Complete the look" pairings (one-way: A suggests B).
  completeTheLook Product[]            @relation("CompleteTheLook")
  suggestedIn     Product[]            @relation("CompleteTheLook")
  categories      Category[]
  collections     Collection[]         @relation("CollectionProducts") // manual collections it's been added to
  optionValues    ProductOptionValue[]
  variants        ProductVariant[]
  media           ProductMedia[]
  reviews         Review[]
  wishlist        Wishlist[]
  backInStock     BackInStockRequest[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  discounts       Discount[]           @relation("DiscountProducts") // product-scoped discounts
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([productTypeId])
  @@index([status, createdAt])
}

/// One choice for one option on a product, e.g. Colour "Navy" (with its swatch).
model ProductOptionValue {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  option      String // one of the product type's optionNames, e.g. "Colour"
  value       String // e.g. "Navy"
  swatchColor String? // hex, e.g. "#1f2a44"
  swatchImage String? // small picture instead of a colour (e.g. a fabric print)
  order       Int              @default(0)
  // Variants that use this value as their 1st, 2nd or 3rd option.
  variants1   ProductVariant[] @relation("VariantOption1")
  variants2   ProductVariant[] @relation("VariantOption2")
  variants3   ProductVariant[] @relation("VariantOption3")
  media       ProductMedia[] // photos shown when this value is chosen

  @@unique([productId, option, value])
  @@index([productId])
}

/// One buyable combination (e.g. Size M + Colour Navy) with its own SKU, price and stock.
/// A product with no options has a single variant with no option values.
model ProductVariant {
  id          String              @id @default(cuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  // option1 matches the product type's 1st option name, option2 the 2nd, option3 the 3rd.
  option1Id   String?
  option1     ProductOptionValue? @relation("VariantOption1", fields: [option1Id], references: [id], onDelete: Cascade)
  option2Id   String?
  option2     ProductOptionValue? @relation("VariantOption2", fields: [option2Id], references: [id], onDelete: Cascade)
  option3Id   String?
  option3     ProductOptionValue? @relation("VariantOption3", fields: [option3Id], references: [id], onDelete: Cascade)
  sku         String?             @unique
  price       Decimal             @db.Decimal(10, 2) // AUD incl. GST
  salePrice   Decimal?            @db.Decimal(10, 2)
  stock       Int                 @default(0)
  weightGrams Int? // for shipping
  barcode     String? // e.g. EAN/UPC
  orderItems  OrderItem[]
  cartItems   CartItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([productId])
}

/// Images/videos for a product (Cloudinary URL), with alt text and sort order.
model ProductMedia {
  id            String              @id @default(cuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValueId String? // set = photo of that option value (e.g. "Navy"), shown when it's chosen
  optionValue   ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)
  url           String
  type          MediaType           @default(IMAGE)
  alt           String?
  order         Int                 @default(0)

  @@index([productId])
}

/// A group of products for banners and home rows: hand-picked (MANUAL) or by rules (AUTOMATIC).
/// Automatic rules that are set must all match (e.g. brand = Casio AND on sale).
model Collection {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  image             String?
  description       String?
  type              CollectionType @default(MANUAL)
  /// Default order on its page and in home rows: newest | best-selling | price-asc | price-desc
  sort              String         @default("newest")
  products          Product[]      @relation("CollectionProducts") // MANUAL: the chosen products
  // AUTOMATIC rules (leave blank to ignore):
  ruleCategoryId    String? // in this category (or one inside it)
  ruleCategory      Category?      @relation(fields: [ruleCategoryId], references: [id], onDelete: SetNull)
  ruleProductTypeId String?
  ruleProductType   ProductType?   @relation(fields: [ruleProductTypeId], references: [id], onDelete: SetNull)
  ruleBrandId       String?
  ruleBrand         Brand?         @relation(fields: [ruleBrandId], references: [id], onDelete: SetNull)
  ruleTag           String?
  ruleOnSale        Boolean        @default(false)
  rulePriceUnder    Decimal?       @db.Decimal(10, 2) // price shoppers pay is below this
  rulePriceOver     Decimal?       @db.Decimal(10, 2) // …or above this
  discounts         Discount[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

/// Promotions: coded or automatic, with type, scope, limits and a usage counter.
model Discount {
  id               String        @id @default(cuid())
  code             String?       @unique // null = automatic offer (no code)
  title            String? // shown to shoppers, e.g. "Buy 3 tees, get 1 free" (announcement bar, bag)
  type             DiscountType
  scope            DiscountScope @default(ALL)
  value            Decimal?      @db.Decimal(10, 2) // percent or dollar amount
  buyQuantity      Int? // "X" for BUY_X_GET_Y
  getQuantity      Int? // "Y" for BUY_X_GET_Y
  minSpend         Decimal?      @db.Decimal(10, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int? // total redemptions allowed
  perCustomerLimit Int?
  firstOrderOnly   Boolean       @default(false)
  timesUsed        Int           @default(0)
  active           Boolean       @default(true)
  categoryId       String? // when scope = CATEGORY
  category         Category?     @relation(fields: [categoryId], references: [id])
  productTypeId    String? // when scope = PRODUCT_TYPE
  productType      ProductType?  @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  brandId          String? // when scope = BRAND
  brand            Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collectionId     String? // when scope = COLLECTION
  collection       Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  products         Product[]     @relation("DiscountProducts") // when scope = PRODUCTS
  orders           Order[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

/// A placed order: human-friendly number (AUS-1001), totals, status and Stripe link.
model Order {
  id                String      @id @default(cuid())
  number            String      @unique // e.g. AUS-1001
  userId            String? // null for guest checkout
  user              User?       @relation(fields: [userId], references: [id])
  email             String
  name              String
  phone             String?
  shippingAddress   Json // snapshot of the delivery address at checkout
  items             OrderItem[]
  subtotal          Decimal     @db.Decimal(10, 2)
  discountTotal     Decimal     @default(0) @db.Decimal(10, 2)
  shippingTotal     Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  discountId        String?
  discount          Discount?   @relation(fields: [discountId], references: [id])
  /// When this paid order was added to its discount's "times used" (so it's never counted twice).
  discountCountedAt DateTime?
  status            OrderStatus @default(PAID)
  trackingNumber    String?
  stripeSessionId   String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
}

/// One line on an order — snapshots name/price so history survives product edits.
model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  name        String // snapshot of product name
  variantName String? // snapshot of variant name
  unitPrice   Decimal         @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

// ── Auth ─────────────────────────────────────────────────────

/// A linked sign-in provider for a user (e.g. their Google account), managed by Auth.js.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One-time links emailed to users (confirm email, reset password). Only a hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// Every sign-in attempt, used to lock an email out after too many failures.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ── Customer data ────────────────────────────────────────────

/// Reusable delivery/billing addresses saved to a customer's account.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // e.g. "Home"
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  postcode  String
  country   String   @default("Australia")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A signed-in customer's shopping bag (guests keep theirs in a cookie until they log in).
model Cart {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCode String? // code entered in the bag, re-checked every time totals are worked out
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// One line in a bag: a product (and finish) and how many. Prices are never stored here.
model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now())

  @@index([cartId])
}

/// A product a customer has saved to their wishlist (one row per product).
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

/// A product rating + text review, hidden until an admin approves it.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String? // shown for guest reviews
  rating     Int // 1–5
  title      String?
  body       String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

/// Email addresses signed up to the marketing newsletter.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

/// "Email me when back in stock" requests for a product/variant.
model BackInStockRequest {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([email])
}

/// Audit trail of what each admin/staff member changed and when.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "product.update"
  entity    String? // e.g. "Product"
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Admin-editable content (used in Prompt 10) ───────────────

/// Single row of global store settings the admin can edit.
model SiteSettings {
  id                    String   @id @default("singleton")
  storeName             String   @default("Aussient")
  supportEmail          String?
  currency              String   @default("AUD")
  freeShippingThreshold Decimal? @db.Decimal(10, 2)
  flatShippingRate      Decimal? @db.Decimal(10, 2)
  socials               Json? // { instagram, tiktok, youtube, threads } → URLs
  newsletterHeading     String?
  newsletterText        String?
  footerPerks           Json? // ["Free shipping over $50", ...]
  tagline               String? // e.g. "Fashion, accessories & lifestyle" — page titles and share image
  metaDescription       String? // the site's default description in Google
  deliveryInfo          String? // "Delivery" section on product pages, one fact per line
  returnsInfo           String? // "Returns" section on product pages, one fact per line
  lowStockAlert         Int      @default(5) // admin warns when a variant has this many or fewer left
  updatedAt             DateTime @updatedAt
}

/// Promotional banners (image + link) placed around the storefront.
model Banner {
  id        String    @id @default(cuid())
  title     String?
  subtitle  String?
  image     String?
  link      String?
  placement String? // "announcement" = scrolling bar at the top of every page
  active    Boolean   @default(true)
  order     Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Editable navigation links (supports nesting via parent/children).
model MenuItem {
  id        String     @id @default(cuid())
  label     String
  url       String
  image     String? // picture shown in the header mega menu
  location  String     @default("header") // header | footer
  order     Int        @default(0)
  parentId  String?
  parent    MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuChildren")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// Configurable blocks that make up the home page, in order, optionally scheduled.
model HomeSection {
  id        String    @id @default(cuid())
  type      String // hero | product-row | category-tiles | promo-banner | image-text | countdown | reviews | instagram | gift-guide | newsletter
  title     String?
  config    Json? // block-specific settings (see src/lib/home-sections.ts)
  order     Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime? // hidden before this time (null = no start limit)
  endsAt    DateTime? // hidden after this time (null = no end limit)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Freeform CMS pages (e.g. About, FAQs) reachable by slug.
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String?
  published      Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Timed modal popups (e.g. newsletter / sale announcement).
model Popup {
  id        String    @id @default(cuid())
  title     String?
  body      String?
  image     String?
  active    Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// URL redirects (old path → new path) managed by the admin.
model Redirect {
  id         String   @id @default(cuid())
  from       String   @unique
  to         String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

/// Editable transactional email templates, keyed by purpose.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "order-confirmation"
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}
